// Packages that are basically essential for a working system (Ubuntu).
// Packages are installed in the order listed.

// Essential fonts
fonts-ibm-plex "apt"
fonts-firacode "apt"

// Essential CLI tools
bat "apt"
curl "apt"
eza "apt"
fzf "apt"
zoxide "apt"
zsh "apt"

// starship is installed from the snap store.
starship "snap"
